# ============================================================
# CodeJudge 环境变量模板
#
# 用法：
#   cp .env.example .env
#   填写所有标注「必须修改」的项（仓库零硬编码，任何密钥都不写进代码与 yml）
#
# 说明：
#   1. 本文件同时被两方读取：
#      · Docker Compose —— 用于 compose 内的 ${VAR} 变量替换；
#      · Spring Boot    —— 各服务 application.yml 通过
#                          spring.config.import: optional:file:./.env[.properties] 读取。
#      因此保持 KEY=VALUE 的 properties 格式（不要加引号、不要在等号两侧留空格）。
#   2. .env 已在 .gitignore 中，**不要提交**。
#   4. 标注「必须修改」的项若保持占位值，相关容器会 fail-closed 拒绝启动
#      （compose 里写的是 ${VAR:?...}）。这是刻意设计：宁可报错，也不静默使用
#      一个人尽皆知的默认凭据。
#   5. 下文的「留空则…」行为是代码里的显式兜底，不依赖本模板。
#
# 生成强随机口令（本机可用）：
#   python -c "import secrets;print(secrets.token_urlsafe(24))"
# 或统一轮换：python scripts/rotate-credentials.py --rotate --write
# ============================================================

# ------------------------------------------------------------
# 基础设施连接（宿主机视角端口，用于本机启动的 Java 服务直连）
# ------------------------------------------------------------
MYSQL_HOST=localhost
MYSQL_PORT=3307
MYSQL_USERNAME=root
# 必须修改：应用连库口令，**必须与下面的 MYSQL_ROOT_PASSWORD 同值**
MYSQL_PASSWORD=your-mysql-password

REDIS_HOST=localhost
REDIS_PORT=6380
# 必须修改：Redis requirepass
REDIS_PASSWORD=your-redis-password

# RocketMQ NameServer（broker 端口 10919/10921/10922 见 deploy/rocketmq/broker.conf）
ROCKETMQ_NAME_SERVER=localhost:9877

# PostgreSQL + pgvector：judge-ai 的向量库（P5 启用）
POSTGRES_URL=jdbc:postgresql://localhost:5433/judge_ai
POSTGRES_USERNAME=postgres
# 必须修改
POSTGRES_PASSWORD=your-postgres-password

# MinIO：判题代码与附件对象存储（P3 起使用）
MINIO_ENDPOINT=http://localhost:9000
MINIO_BUCKET=codejudge
MINIO_ROOT_USER=codejudge
# 必须修改
MINIO_ROOT_PASSWORD=your-minio-password

# ------------------------------------------------------------
# Docker Compose 容器端口映射（与上面宿主机端口保持一致）
# ------------------------------------------------------------
# 中间件监听地址：默认只绑回环（不对局域网暴露 root 口令的数据库/缓存）。
# 确需局域网访问时改为 0.0.0.0（仅限隔离网络）
BIND_IP=127.0.0.1
MYSQL_BIND_PORT=3307
# 必须修改：容器实际使用的 root 口令，与 MYSQL_PASSWORD 同值
MYSQL_ROOT_PASSWORD=your-mysql-root-password
REDIS_BIND_PORT=6380
POSTGRES_BIND_PORT=5433
ROCKETMQ_NAMESRV_BIND_PORT=9877
ROCKETMQ_CONSOLE_BIND_PORT=18081
MINIO_API_BIND_PORT=9000
MINIO_CONSOLE_BIND_PORT=9001

# ------------------------------------------------------------
# 服务发现（本地默认关闭 Nacos，靠静态实例 + 网关直连）
# ------------------------------------------------------------
NACOS_ENABLED=false
NACOS_CONFIG_ENABLED=false
NACOS_ADDR=localhost:8848

# 本地静态实例地址（Nacos 关闭时生效）
# ⚠ 显式写出而非依赖 yml 默认值：漏写会静默退回同名默认值，排查时极难发现。
SVC_USER_URI=http://localhost:9082
SVC_PROBLEM_URI=http://localhost:9083
SVC_SUBMISSION_URI=http://localhost:9084
SVC_CONTEST_URI=http://localhost:9086
GW_AUTH_URI=http://localhost:9081
GW_USER_URI=http://localhost:9082
GW_PROBLEM_URI=http://localhost:9083
GW_SUBMISSION_URI=http://localhost:9084
GW_CONTEST_URI=http://localhost:9086
GW_AI_URI=http://localhost:9087

# 网关 CORS 允许来源（生产按真实域名覆盖，逗号分隔）
# ⚠ 不可写成 `*`：网关使用 allowedOriginPatterns，通配会让携带凭据的跨域请求失去来源约束。
CORS_ALLOWED_ORIGINS=http://localhost:[*],http://127.0.0.1:[*]

# ------------------------------------------------------------
# 安全 / 认证
# ------------------------------------------------------------
# 必须修改：JWT 签名密钥（HS256 对称密钥，网关与 judge-auth 共用）。
#   长度 ≥ 32 字节。生成：
#     python -c "import secrets,base64;print(base64.urlsafe_b64encode(secrets.token_bytes(48)).decode().rstrip('='))"
#   字符集建议限 URL-safe（A-Za-z0-9-_），规避 + / = 在 properties 与 compose
#   插值语境下的转义边界情况。
#   ⚠ 换值即**所有已签发 Token 立即失效**（需重新登录）。
CJ_JWT_SECRET=your-jwt-secret-at-least-32-bytes

# 首个管理员安全引导（judge-auth 启动时执行，凭据落盘后首次改密即删除）
CJ_ADMIN_CREDENTIAL_FILE=.bootstrap-credentials
CJ_ADMIN_PHONE=13800000000
CJ_ADMIN_USERNAME=admin
# 首个管理员初始口令。
#   · 留空 → 引导时生成一次性 24 位随机强口令，**只写入 CJ_ADMIN_CREDENTIAL_FILE**（不进日志）；
#   · 填写 → 必须 ≥ 16 位随机串，否则启动日志会告警。
#   源码里**没有**任何兜底默认值（历史版本曾是 123456，已移除）。
CJ_ADMIN_INIT_PASSWORD=

# 管理员「重置密码」接口写回的统一初始口令。
#   · 留空 → 该接口 fail-closed，返回 400 并说明原因（不会静默降级为固定弱口令）；
#   · 填写 → 必须 ≥ 16 位随机串。
#   重置密码是把一个已知字符串写进**别人的**账号，可预测 = 全站统一后门。
CJ_USER_DEFAULT_PASSWORD=

# ------------------------------------------------------------
# LLM（OpenAI 兼容协议）—— P5 AI 代码点评使用
# 未配置 KEY 时 CJ_LLM_ENABLED 保持 false，服务降级为结构化提示而非 500
# ------------------------------------------------------------
CJ_LLM_ENABLED=false
CJ_LLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
CJ_LLM_CHAT_PATH=chat/completions
# 必须修改（启用 LLM 时）：模型服务方签发的 API Key，属敏感凭据，勿入库
CJ_LLM_API_KEY=
CJ_LLM_MODEL=glm-4.5-air
CJ_LLM_TEMPERATURE=0.8
CJ_LLM_TOP_P=0.95
CJ_LLM_MAX_TOKENS=1024
# 向量化：路径必须与 base-url 配套（智谱 base-url 已含 /api/paas/v4 → embedding-path=embeddings）
# 配错会拼出 /v4/v1/embeddings 这类 404 地址，Embedding 恒定失败并静默降级为伪向量，RAG 失去语义
CJ_LLM_EMBEDDING_PATH=embeddings
CJ_LLM_EMBEDDING_MODEL=embedding-3
# 维度必须等于 pgvector 中 knowledge_chunk.embedding 的维度（1024），且 HNSW 上限为 2000 维
CJ_LLM_EMBEDDING_DIMENSION=1024

# ---- RAG 与点评策略（judge-ai）----
# 并发 SSE 流上限：按 Tomcat 线程与下游 LLM 配额取小值，防打爆上游触发 429
CJ_RAG_MAX_STREAMS=200
# 是否携带多轮历史；关闭可省 token，但会失去上下文指代能力
CJ_RAG_HISTORY_ENABLED=true
# 是否允许返回完整题解。**保持 false**：直接给答案会破坏题目训练价值
CJ_REVIEW_ALLOW_FULL_SOLUTION=false
# 是否用 MQ 异步做点评（false = 同步流式，本地开发取同步便于观察）
CJ_REVIEW_MQ_ENABLED=false

# ------------------------------------------------------------
# 判题与沙箱 —— P3 使用
# ------------------------------------------------------------
# 运行时：runc（本机可用，默认）/ runsc（需自行安装 gVisor）
CJ_SANDBOX_RUNTIME=runc
CJ_SANDBOX_IMAGE_JAVA=codejudge/judge-java21:latest
CJ_SANDBOX_IMAGE_PYTHON=codejudge/judge-python312:latest
CJ_SANDBOX_IMAGE_CPP=codejudge/judge-gcc13:latest
CJ_SANDBOX_IMAGE_GO=codejudge/judge-go122:latest
# 输出上限（KB），防输出爆炸
CJ_SANDBOX_MAX_OUTPUT_KB=1024
# 单容器进程数上限，防 fork 炸弹
CJ_SANDBOX_PIDS_LIMIT=64
# CPU 配额（核数）—— 限制单次判题可占用的算力，防「一道题吃满整机」
CJ_SANDBOX_CPUS=1.0
# 编译期进程数上限（javac/g++ 会派生大量子进程，故高于运行期）
CJ_SANDBOX_COMPILE_PIDS_LIMIT=256
# 编译超时（毫秒）
CJ_SANDBOX_COMPILE_TIMEOUT_MS=30000
# 墙钟宽限（毫秒）：在 CPU 时间之外额外允许的等待，覆盖 JVM 启动等 I/O 抖动
CJ_SANDBOX_WALL_GRACE_MS=5000
# seccomp 配置：白名单式系统调用过滤，路径相对服务启动目录
CJ_SANDBOX_SECCOMP=sandbox/seccomp/judge-seccomp.json
# 判题任务超时与重试
CJ_JUDGE_TASK_TIMEOUT_MS=60000
CJ_JUDGE_MAX_ATTEMPT=3
# 判题机多实例必须配置消费线程数，且满足「实例数 × 该值 ≤ 宿主机 CPU 核数」。
# 未配置（=0，默认）时行为同旧版（20 线程）；多实例高并发会因容器冷启动超出墙钟预算
# 而把正确解判成假 TLE（实测 3 实例 60 并发：抽样 18/25 假 TLE）。单实例可留空。
# CJ_MQ_CONSUME_THREADS=4

# worker 心跳过期时间（秒），过期即判定离线并触发故障转移
CJ_JUDGE_WORKER_HEARTBEAT_SECONDS=30
# worker 工作根目录（每次判题在其下创建独立子目录，结束即清理）
CJ_WORKER_WORK_ROOT=logs/worker-work
# 判题进度推送开关（关闭后只推终态，可显著降低 MQ 压力）
CJ_JUDGE_PROGRESS_ENABLED=true

# ------------------------------------------------------------
# 提交侧限流 —— judge-submission 使用
# ------------------------------------------------------------
# 单用户每分钟提交次数上限，防刷题机/误点造成判题队列雪崩
CJ_SUBMIT_RATE_LIMIT=30

# ------------------------------------------------------------
# 网关登录限流（Redis 令牌桶）—— 生产默认值，勿随意放宽
# ------------------------------------------------------------
# ⚠ 压测时需临时放宽（见 docs/DEPLOYMENT.md §4.1），**压测后必须恢复为下面的值**，
#   并用 preflight 的 C1 项复验（期望 12 次瞬时登录 → 5×200 + 7×429）。
#   显式写出（而非依赖 yml 默认值）是为了让"是否处于放宽状态"一眼可查。
GW_LOGIN_RATE_REPLENISH=2
GW_LOGIN_RATE_BURST=5

# ------------------------------------------------------------
# 竞赛与 WebSocket 推送 —— P4 使用
# ------------------------------------------------------------
# 判题进度推送的最小间隔（毫秒）：越小越实时、MQ 压力越大（末用例强制推送，不受此限）
CJ_JUDGE_PROGRESS_MIN_INTERVAL_MS=800
# 榜单推送合并窗口（毫秒）：窗口内的多次 AC 只推一次「当前终态」，这是推送频率控制的核心参数
CJ_CONTEST_PUSH_INTERVAL_MS=1000
# 竞赛状态扫描间隔（毫秒）：开赛/封榜/结束的推进与快照
CJ_CONTEST_SCAN_INTERVAL_MS=10000
# 榜单下发条数上限
CJ_CONTEST_RANK_TOP=100
# 竞赛提交是否需要已报名
CJ_CONTEST_REQUIRE_REGISTRATION=true
# WS 跨实例广播通道名（同一服务多个实例必须一致，否则会话分散在不同实例上收不到推送）
CJ_WS_CHANNEL=judge:ws:broadcast
# WS 心跳间隔（毫秒），0=关闭心跳
CJ_WS_HEARTBEAT_MS=30000

# ------------------------------------------------------------
# 监控栈（deploy/monitoring/docker-compose.monitoring.yml）—— 独立部署
# ------------------------------------------------------------
# ⚠ 这些变量只在该 compose 里生效，且启动时**必须带 --env-file**：
#     cd deploy/monitoring
#     docker-compose --env-file ../../.env -f docker-compose.monitoring.yml up -d
#   本机的 docker-compose 二进制不读 shell 环境变量做插值（前缀赋值与 export 均实测无效），
#   省掉 --env-file 会**静默**退回默认值：监控照常启动，但 Grafana 密码与告警通道
#   全是默认值 —— 不报错、不复现，最难查。
#   为此 compose 里的敏感项已改为 fail-closed（${VAR:?…}），漏 --env-file 时直接报错。

# 监控栈端口
PROMETHEUS_BIND_PORT=9090
ALERTMANAGER_BIND_PORT=9093
GRAFANA_BIND_PORT=3001

GRAFANA_ADMIN_USER=admin
# 必须修改：Grafana 管理员口令。
#   生成：python -c "import secrets;print(secrets.token_urlsafe(24))"
#   （刻意不在本文件写出任何"口令前缀样例"，否则泄漏扫描会产生误报）
#   ⚠ Grafana 只在**首次创建 grafana.db** 时用本变量建立管理员；volume 已存在时
#     "重建容器"不必然改密，需 `grafana cli admin reset-admin-password` 兜底。
#   生效命令：
#     cd deploy/monitoring && docker-compose --env-file ../../.env -f docker-compose.monitoring.yml up -d --force-recreate grafana
GRAFANA_ADMIN_PASSWORD=

# Grafana 匿名访问。默认 false（fail-closed）；本地要免登录只读请显式置 true。
# 注意：匿名开启意味着 /d/ 下的看板无需登录即可读，生产环境务必置 false。
GF_AUTH_ANONYMOUS_ENABLED=true
GF_AUTH_ANONYMOUS_ORG_ROLE=Viewer

# ---- 告警外发（默认 null = 告警只出现在 Alertmanager UI，不外发）----
# 取值：null / email / webhook / wecom
# 接入文档：deploy/monitoring/alertmanager/README.md
ALERTMANAGER_DEFAULT_RECEIVER=null
# critical 路由的接收器 —— 生产不可为 null，否则真正的事故没人收到（preflight F1 FAIL）
ALERTMANAGER_CRITICAL_RECEIVER=null

# 企业微信/钉钉 webhook。⚠ 需要一层转换器：Alertmanager 原生 webhook 的 JSON
# 与机器人要求的 {msgtype:...} 格式不兼容，直接填机器人 URL 收不到消息。
ALERTMANAGER_WECOM_WEBHOOK=

# 邮件通道（Alertmanager 原生支持，零中间件）—— 生产首选
# 系统不提供 SMTP 凭据，须由部署方填入；六项全空 = 告警只进 UI，不外发。
ALERTMANAGER_SMTP_SMARTHOST=
ALERTMANAGER_SMTP_FROM=
ALERTMANAGER_SMTP_AUTH_USERNAME=
ALERTMANAGER_SMTP_AUTH_PASSWORD=
ALERTMANAGER_EMAIL_TO=
