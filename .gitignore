# ---------- 构建产物 ----------
target/
!.mvn/wrapper/maven-wrapper.jar
!**/src/main/**/target/
!**/src/test/**/target/

# ---------- IDE ----------
.idea/
*.iws
*.iml
*.ipr
.vscode/
.settings/
.classpath
.project
.factorypath

# ---------- OS ----------
.DS_Store
Thumbs.db

# ---------- 日志与运行时产物 ----------
logs/
*.log
nohup.out

# ---------- 环境变量与凭据（仓库零硬编码，只保留模板） ----------
.env
.env.*
!.env.example
.env.local
.env.*.local
# 非「.env 开头」的同类文件（secrets.env / app.env 这类命名不会命中上面的规则）
*.env
# 首个管理员安全引导落盘的初始凭据，首登改密后自动删除
.bootstrap-credentials

# ---------- 密钥 / 证书 ----------
*.pem
*.key
*.p12
*.pfx
*.jks
*.keystore
id_rsa*
id_ed25519*
known_hosts
*.secret
*credentials*.json
service-account*.json

# ---------- 沙箱与判题运行产物 ----------
# 沙箱工作目录（每次判题独立创建，结束即清理；异常中断时可能残留）
sandbox/work/
sandbox/out/
# 判题机本地落盘的编译产物与临时文件
judge-worker/work/
judge-worker/tmp/

# ---------- 数据导出 / 备份（可能含真实用户数据） ----------
*.dump
*.sql.gz
dumps/
backup/
*.bak

# ---------- Python 工具脚本缓存 ----------
__pycache__/
*.py[cod]
.pytest_cache/

# ---------- JVM 崩溃转储 ----------
hs_err_pid*.log
replay_pid*.log
*.hprof

# ---------- 前端本地依赖与产物（P6） ----------
node_modules/
.pnpm-store/
judge-web/dist/
judge-web/.env.local
judge-web/.env.*.local
judge-web/test-results/
judge-web/playwright-report/
# vitest 覆盖率报告：HTML 形态是 56 个文件（每次 npm run test:cov 重建），
# 与 perf-test/results/ 同类 —— 纯派生产物，无入库价值（2026-09-22 首提交预演时发现遗漏）
judge-web/coverage/

# ---------- 压测产物与账号池（P6） ----------
# ① .jtl 原始数据单轮可达**数十 MB**（恒定负载计划实测 180s → 29MB，
#    失控那轮涨到 400MB），HTML 报告又是上千个小文件；
# ② csv/users.csv 里是**明文压测账号密码**（seed-users.py 生成的），
#    属于"本地测试凭据"，与仓库零硬编码规范冲突。
# 两者都能一键重建（跑一次压测即可），没有任何入库价值。
perf-test/results/
perf-test/csv/
perf-test/reports/

# ---------- AI 协作工作区数据（含本地测试凭据与缺陷复盘，不入库） ----------
.workbuddy/

# ---------- 数据库备份（2026-09-22 新增） ----------
# mysql/*.sql 与 pg/*.dump 是**真实业务数据快照**（用户、提交、判题结果），
# 且体量随使用增长；RDB 同理。入库既违反隐私边界，也没有价值
# —— 备份是"某时某刻的运行态产物"，需要时用 scripts/backup-volumes.py 重建即可。
backups/

# ---------- 临时探针/中间产物（勿入库） ----------
logs/_probe.txt
logs/_p6.txt

# Vite 在加载 ESM/CJS 配置文件时会就地落一个 `*.timestamp-<毫秒>-<hash>.mjs` 副本
# （vite.config.js / vitest.config.js 各一套）。它们**不是源码**，但会随 `git add .` 一起进提交
# —— 2026-09-23 发现 judge-web/ 下已积了 16 个（116K）且未被忽略。
# 与 perf-test/results/、judge-web/coverage/ 属同一类：构建副产物必须显式排除。
*.timestamp-*.mjs
