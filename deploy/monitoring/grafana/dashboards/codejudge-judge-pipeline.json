      "targets": [
        {
          "refId": "A",
          "expr": "max(judge_queue_backlog{job=\"codejudge\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "codejudge-prom"
          },
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
