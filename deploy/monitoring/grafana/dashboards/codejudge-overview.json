    {
      "id": 11,
      "type": "table",
      "title": "服务状态明细",
      "datasource": {
        "type": "prometheus",
        "uid": "codejudge-prom"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 6
      },
      "targets": [
        {
          "refId": "A",
          "expr": "up{job=\"codejudge\", application=~\"$application\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "codejudge-prom"
          },
          "format": "table",
          "instant": true,
          "range": false
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "indexByName": {},
            "renameByName": {
              "Time": "",
              "application": "服务",
              "instance": "实例",
              "job": "作业",
              "Value": "存活(1=是)"
            }
          }
        }
      ],
      "options": {
        "showHeader": true,
        "sortBy": [
          {
            "displayName": "Value",
            "desc": true
          }
        ]
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "custom": {
            "align": "auto"
          }
        },
        "overrides": []
      }
