{
  "uid": "codejudge-worker-cluster",
  "title": "CodeJudge 判题机集群",
  "description": "多实例运行态与每实例分布。注意：本机实测加实例不涨吞吐（瓶颈=每题 5 容器启停），扩容先减每题容器数或跨宿主部署，并配 CJ_MQ_CONSUME_THREADS（实例数×值≤CPU 核数）。",
  "tags": [
    "judge",
    "codejudge"
  ],
  "timezone": "browser",
  "editable": false,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "templating": {
    "list": []
  },
  "annotations": {
    "list": [
      {
        "builtIn": 1,
        "datasource": {
          "type": "grafana",
          "uid": "-- Grafana --"
        },
        "enable": true,
        "hide": true,
        "name": "Annotations & Alerts",
        "type": "dashboard"
      }
    ]
  },
  "panels": [
    {
      "id": 61,
      "type": "row",
      "title": "集群体检",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 0
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 62,
      "type": "stat",
      "title": "在线 worker 数",
      "datasource": {
        "type": "prometheus",
        "uid": "codejudge-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 0,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(judge_workers_online{job=\"codejudge\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "codejudge-prom"
          },
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 63,
      "type": "stat",
      "title": "集群消费速率",
      "datasource": {
        "type": "prometheus",
        "uid": "codejudge-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 4,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{job=\"codejudge\", application=\"judge-worker\"}[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "codejudge-prom"
          },
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "none",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "color": {
            "mode": "palette-classic"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      }
    },
    {
      "id": 64,
      "type": "stat",
      "title": "待判积压",
      "datasource": {
        "type": "prometheus",
        "uid": "codejudge-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 8,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(judge_queue_backlog{job=\"codejudge\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "codejudge-prom"
          },
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 20
              },
              {
                "color": "red",
                "value": 100
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 65,
      "type": "stat",
      "title": "死信任务",
      "datasource": {
        "type": "prometheus",
        "uid": "codejudge-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 12,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(judge_dead_tasks{job=\"codejudge\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "codejudge-prom"
          },
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "none",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "red",
                "value": 1
              }
            ]
          },
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 66,
      "type": "stat",
      "title": "worker 堆峰值占用比",
      "datasource": {
        "type": "prometheus",
        "uid": "codejudge-prom"
      },
      "gridPos": {
        "h": 5,
        "w": 4,
        "x": 16,
        "y": 1
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max(jvm_memory_used_bytes{job=\"codejudge\", application=\"judge-worker\", area=\"heap\"}) / max(jvm_memory_max_bytes{job=\"codejudge\", application=\"judge-worker\", area=\"heap\"})",
          "datasource": {
            "type": "prometheus",
            "uid": "codejudge-prom"
          },
          "legendFormat": "",
          "instant": true,
          "range": false
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "auto",
        "justifyMode": "auto",
        "orientation": "auto"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": {
            "mode": "thresholds"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "yellow",
                "value": 0.75
              },
              {
                "color": "red",
                "value": 0.9
              }
            ]
          },
          "decimals": 3
        },
        "overrides": []
      }
    },
    {
      "id": 67,
      "type": "row",
      "title": "实例级趋势",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 6
      },
      "collapsed": false,
      "panels": []
    },
    {
      "id": 68,
      "type": "timeseries",
      "title": "每实例消费速率（多实例按 instance 分列）",
      "datasource": {
        "type": "prometheus",
        "uid": "codejudge-prom"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (instance) (rate(http_server_requests_seconds_count{job=\"codejudge\", application=\"judge-worker\"}[1m]))",
          "datasource": {
            "type": "prometheus",
            "uid": "codejudge-prom"
          },
          "legendFormat": "{{instance}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
          ]
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "smooth",
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never",
            "spanNulls": false,
            "stacking": {
              "mode": "none",
              "group": "A"
            },
            "axisPlacement": "auto",
            "scaleDistribution": {
              "type": "linear"
            }
          },
          "decimals": 3
        },
        "overrides": []
      }
    },
    {
      "id": 69,
      "type": "timeseries",
      "title": "每实例 CPU / 堆",
      "datasource": {
        "type": "prometheus",
        "uid": "codejudge-prom"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 7
      },
      "targets": [
        {
          "refId": "A",
          "expr": "process_cpu_usage{job=\"codejudge\", application=\"judge-worker\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "codejudge-prom"
          },
          "legendFormat": "CPU {{instance}}"
        },
        {
          "refId": "B",
          "expr": "jvm_memory_used_bytes{job=\"codejudge\", application=\"judge-worker\", area=\"heap\"}",
          "datasource": {
            "type": "prometheus",
            "uid": "codejudge-prom"
          },
          "legendFormat": "heap {{instance}}"
        }
      ],
      "options": {
        "legend": {
          "displayMode": "table",
          "placement": "bottom",
          "showLegend": true,
          "calcs": [
            "mean",
            "max",
            "lastNotNull"
