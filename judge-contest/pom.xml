<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.codejudge</groupId>
        <artifactId>codejudge</artifactId>
        <version>1.0.0</version>
    </parent>

    <artifactId>judge-contest</artifactId>
    <name>judge-contest</name>
    <description>竞赛服务：竞赛生命周期/报名、Redis ZSet 实时榜、封榜快照、WebSocket 榜单推送</description>

    <dependencies>
        <dependency>
            <groupId>com.codejudge</groupId>
            <artifactId>judge-common</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>com.codejudge</groupId>
            <artifactId>judge-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-actuator</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-data-redis</artifactId>
        </dependency>
        <!-- WS 推送端点：判题进度推送在 judge-submission，榜单推送在本服务 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-loadbalancer</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-spring-boot3-starter</artifactId>
        </dependency>
        <dependency>
            <groupId>com.baomidou</groupId>
            <artifactId>mybatis-plus-jsqlparser</artifactId>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-discovery</artifactId>
        </dependency>
        <dependency>
            <groupId>com.alibaba.cloud</groupId>
            <artifactId>spring-cloud-starter-alibaba-nacos-config</artifactId>
        </dependency>
        <!--
          只消费不生产：本服务订阅 judge_submission 的 RESULT 事件，
          但不需要 RocketMQTemplate —— 因此 application.yml 中只配 name-server + consumer-group，
          配合 RocketMqAutoConfiguration 的 @ConditionalOnProperty(producer-group) 即不装配生产者
          （否则空 producer-group 会让 DefaultMQProducer 启动直接报错）。
        -->
    </dependencies>

    <build>
        <finalName>judge-contest</finalName>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>com.codejudge.contest.ContestApplication</mainClass>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
