{
  "description": "CodeJudge 判题沙箱 seccomp profile：默认放行 + 显式禁用危险 syscall。配合 docker run --cap-drop ALL --security-opt no-new-privileges --network none --read-only 使用（PLAN §6 第 10 条）。",
  "defaultAction": "SCMP_ACT_ALLOW",
  "archMap": [
    { "architecture": "SCMP_ARCH_X86_64", "subArchitectures": ["SCMP_ARCH_X86", "SCMP_ARCH_X32"] },
    { "architecture": "SCMP_ARCH_AARCH64", "subArchitectures": ["SCMP_ARCH_ARM"] }
  ],
  "syscalls": [
    {
      "names": [
        "mount",
        "umount",
        "umount2",
        "pivot_root",
        "chroot",
        "ptrace",
        "process_vm_readv",
        "process_vm_writev",
        "kexec_load",
        "kexec_file_load",
        "reboot",
        "swapon",
        "swapoff",
        "init_module",
        "finit_module",
        "delete_module",
        "setns",
        "unshare",
        "open_by_handle_at",
        "name_to_handle_at",
        "bpf",
        "perf_event_open",
        "keyctl",
        "add_key",
        "request_key",
        "userfaultfd",
        "iopl",
        "ioperm",
        "quotactl",
        "nfsservctl",
        "acct",
        "lookup_dcookie",
        "mbind",
        "move_pages",
        "set_mempolicy"
      ],
      "action": "SCMP_ACT_ERRNO",
      "errnoRet": 1
    }
  ]
}
